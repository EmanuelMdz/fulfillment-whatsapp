{
  "name": "fulfillment-whatsapp",
  "private": true,
  "version": "0.2.0",
  "description": "Atencion y ventas por WhatsApp con IA. Un repo, un deploy, modulos que se prenden y se apagan.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/bot",
    "dev:panel": "npm run dev --workspace=apps/panel",
    "build": "npm run build --workspace=apps/panel && npm run build --workspace=apps/bot",
    "start": "npm run start --workspace=apps/bot",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --import ./tests/bootstrap.mjs --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "db:sql": "node scripts/db-sql.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:limpiar": "node scripts/demo.mjs limpiar",
    "prompt:push": "node scripts/prompt.mjs push",
    "prompt:pull": "node scripts/prompt.mjs pull",
    "type-check": "npm run type-check --workspace=apps/bot",
    "check": "npm test && npm run type-check && npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
