# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# El instalador (npm run setup) puede hacerlo por vos.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Supabase) ──────────────────────────────────
# Uno por instalación. No se comparte entre negocios.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Esta va al navegador: es la clave publica, no la de servicio.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Modelos de IA ─────────────────────────────────────────────
# Cual usa cada agente se define en codigo, no acá.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── WhatsApp ──────────────────────────────────────────────────
# URL de tu puente de WhatsApp. La sesion y el QR se crean desde
# el panel: acá solo va la direccion y la clave.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default
WHATSAPP_WEBHOOK_SECRET=

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
TIMEZONE=America/Montevideo
LOG_LEVEL=info

# Numero o grupo que recibe los avisos. Se configura desde el panel;
# esto es solo el valor inicial.
NOTIFY_CHAT_ID=
