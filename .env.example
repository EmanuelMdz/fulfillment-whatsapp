# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# El instalador (npm run setup) puede hacerlo por vos.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Supabase) ──────────────────────────────────
# Uno por instalación. No se comparte entre negocios.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Esta va al navegador: es la clave publica, no la de servicio.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Modelos de IA ─────────────────────────────────────────────
# 'gemini' u 'openai'.
LLM_PROVIDER=gemini
# OJO: los nombres de modelo cambian seguido. Si el bot no contesta y en los
# registros aparece un 404, es casi seguro que este nombre ya no existe.
# Poné el modelo rapido y barato que tenga hoy tu proveedor.
LLM_MODEL=gemini-2.5-flash

GEMINI_API_KEY=
OPENAI_API_KEY=

# ── WhatsApp ──────────────────────────────────────────────────
# URL de tu puente de WhatsApp. La sesion y el QR se crean desde
# el panel: acá solo va la direccion y la clave.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default
WHATSAPP_WEBHOOK_SECRET=

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
TIMEZONE=America/Montevideo
LOG_LEVEL=info

# URL publica del deploy (la que te da Railway). Se usa para que los
# avisos al grupo lleven un link clickeable a la conversacion en el panel.
PUBLIC_URL=

# Numero o grupo que recibe los avisos. Se configura desde el panel;
# esto es solo el valor inicial.
NOTIFY_CHAT_ID=

# ── Comportamiento del bot ────────────────────────────────────
# Cuanto espera antes de contestar, para juntar los mensajes sueltos.
# Bajarlo hace que el bot se sienta apurado y conteste tres veces seguidas.
DEBOUNCE_SECONDS=90

# Pausa entre un envio y el siguiente. NO subir el ritmo: es lo que evita
# que WhatsApp bloquee el numero.
SEND_PAUSE_MIN_MS=2000
SEND_PAUSE_MAX_MS=6000

# Cada cuanto miran la cola de envio, los turnos y los seguimientos vencidos.
SEND_TICK_MS=8000
TURN_TICK_MS=10000
FOLLOWUP_TICK_MS=60000
